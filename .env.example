# ==============================================================================
# NEONEXUS AI MODULE CONFIGURATION TEMPLATE
# Copy this file to '.env' and fill in your actual credentials.
# ==============================================================================

# Google AI Studio API Key (Obtain from: https://aistudio.google.com/)
# Crucial for Gemma Integration and Prompt Engineering phases.
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Gemma / Gemini LLM Model Settings
# Defaulting to gemini-2.5-flash which is the standard, low-latency model.
# Can also be set to gemma2-9b-it (instruct model) or others if supported by your API tier.
GEMINI_MODEL=gemini-2.5-flash

# Embeddings Model for RAG
# Using a lightweight, high-performance local SentenceTransformer model.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Storage Paths (Relative to project root or absolute paths)
FAISS_INDEX_PATH=data/vector_store/faiss_index
CNN_MODEL_PATH=best_model.pth

# Application Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
